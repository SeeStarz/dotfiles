pkgname=seestarz-system
pkgver=1.0
pkgrel=1
pkgdesc="System policy metapackage: drivers, audio, bootloader"
arch=(any)
depends=(
  # Boot
  os-prober # Dual boot detection
  grub

  # CPU microcode
  amd-ucode

  # Audio
  sof-firmware
  pipewire-alsa
  pipewire-pulse
  pipewire
  lib32-pipewire

  # OpenGL (Intel & AMD)
  mesa
  lib32-mesa

  # Vulkan (Intel & AMD)
  vulkan-radeon
  lib32-vulkan-radeon

  # Nvidia drivers
  nvidia-open
  nvidia-utils
  lib32-nvidia-utils

  # OpenCL
  opencl-mesa
  opencl-nvidia
)
